{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Studio AI",
  "version": "0.1.3",
  "identifier": "com.musicstudio.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Music Studio AI — Nâng Hạ Tone & Tách Nhạc",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["models/.gitkeep"],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
