{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Music Studio AI",
  "version": "0.1.0",
  "identifier": "com.musicstudio.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Music Studio AI — Nâng Hạ Tone & Tách Nhạc Local ONNX (Rust)",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": ["models/.gitkeep"]
  }
}
